<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mobile.standalone.mapper.AgentKnowledgeMapper">

    <resultMap id="AgentKnowledgeMap" type="com.mobile.standalone.entity.AgentKnowledge">
        <id property="id" column="id"/>
        <result property="topic" column="topic"/>
        <result property="content" column="content"/>
        <result property="snippet" column="snippet"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- 对齐 Python：SELECT id, topic, SUBSTR(content,1,200) AS snippet, created_at -->
    <select id="search" resultMap="AgentKnowledgeMap">
        SELECT id, topic,
               SUBSTR(content, 1, 200) AS snippet,
               created_at
        FROM knowledge
        WHERE topic LIKE CONCAT('%', #{query}, '%')
           OR content LIKE CONCAT('%', #{query}, '%')
        ORDER BY created_at DESC
        LIMIT #{limit}
    </select>

    <select id="countAll" resultType="int">
        SELECT COUNT(1) FROM knowledge
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO knowledge (topic, content)
        VALUES (#{topic}, #{content})
    </insert>
</mapper>
