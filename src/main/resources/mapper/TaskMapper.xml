<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mobile.standalone.mapper.TaskMapper">
    
    <resultMap id="TaskResultMap" type="com.mobile.standalone.entity.Task">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="projectPath" column="project_path"/>
        <result property="scriptPath" column="script_path"/>
        <result property="platform" column="platform" typeHandler="org.apache.ibatis.type.EnumTypeHandler"/>
        <result property="deviceId" column="device_id"/>
        <result property="appId" column="app_id"/>
        <result property="taskType" column="task_type" typeHandler="org.apache.ibatis.type.EnumTypeHandler"/>
        <result property="scenarioKey" column="scenario_key"/>
        <result property="status" column="status" typeHandler="org.apache.ibatis.type.EnumTypeHandler"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="config" column="config"/>
        <result property="flowId" column="flow_id"/>
        <result property="runTrack" column="run_track"/>
        <result property="workerId" column="worker_id"/>
    </resultMap>
    
    <select id="findAll" resultMap="TaskResultMap">
        SELECT * FROM tasks ORDER BY created_at DESC
    </select>
    
    <!--
      任何一次执行都算。
      原来只认 AUTOMATION 轨，理由是「回归跑的是生产包、用例写的是新功能，贴过去是造假」。
      那个理由现在不成立了：回归批次跑线上老包时，本版新功能的流程已经被 release_stage
      过滤掉了，能跑到的流程一定是「这个包里有这个功能」——那就是一次有效执行。
      继续只认一条轨的话，SHARED 流程只在回归里跑过就会显示「已覆盖但从没跑过」。
    -->
    <!-- 排除试跑：你在编辑器里调三次挂两次，那两次不该被当成这条流程的「最近结果」，
         否则列表上一片红，而红的原因是你自己在调试。走 idx_flow_track(flow_id, run_track) -->
    <select id="findLatestByFlowId" resultMap="TaskResultMap">
        SELECT * FROM tasks
        WHERE flow_id = #{flowId}
          AND (run_track IS NULL OR run_track &lt;&gt; 'DEBUG')
        ORDER BY COALESCE(updated_at, created_at) DESC
        LIMIT 1
    </select>

    <!--
        试跑轨的最近一次。
        和上面那条是刻意分开的两个问题：上面回答「这条流程的质量结论」，所以必须排除试跑；
        这条回答「我刚才那次跑成啥样了」，只有试跑才算数。
        合成一个查询的话，两个问题必然有一个答错。
    -->
    <select id="findLatestDebugByFlowId" resultMap="TaskResultMap">
        SELECT * FROM tasks
        WHERE flow_id = #{flowId}
          AND run_track = 'DEBUG'
        ORDER BY COALESCE(updated_at, created_at) DESC
        LIMIT 1
    </select>

    <select id="findById" resultMap="TaskResultMap">
        SELECT * FROM tasks WHERE id = #{id}
    </select>
    
    <!--
        排队中的任务：状态还是 PENDING、且没分到设备。
        「没分到设备」用 device_id 判断，而不是另加一个 queued 标志位——
        标志位和真实状态迟早会不一致，而这里的 device_id 本来就是权威。
    -->
    <select id="findQueued" resultMap="TaskResultMap">
        SELECT * FROM tasks
        WHERE status = 'PENDING' AND (device_id IS NULL OR device_id = '')
        ORDER BY created_at ASC
        LIMIT #{limit}
    </select>

    <select id="countQueued" resultType="int">
        SELECT COUNT(1) FROM tasks
        WHERE status = 'PENDING' AND (device_id IS NULL OR device_id = '')
    </select>

    <select id="findByStatus" resultMap="TaskResultMap">
        SELECT * FROM tasks WHERE status = #{status} ORDER BY created_at DESC
    </select>
    
    <select id="findByPlatform" resultMap="TaskResultMap">
        SELECT * FROM tasks WHERE platform = #{platform} ORDER BY created_at DESC
    </select>
    
    <select id="findByTaskType" resultMap="TaskResultMap">
        SELECT * FROM tasks WHERE task_type = #{taskType} ORDER BY created_at DESC
    </select>

    <sql id="genericFilterWhere">
        <where>
            <if test="taskType != null">
                AND task_type = #{taskType}
            </if>
            <if test="platform != null">
                AND platform = #{platform}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
            <if test="deviceId != null and deviceId != ''">
                AND device_id = #{deviceId}
            </if>
            <if test="appId != null and appId != ''">
                AND app_id = #{appId}
            </if>
        </where>
    </sql>

    <select id="findByFilters" resultMap="TaskResultMap">
        SELECT * FROM tasks
        <include refid="genericFilterWhere"/>
        ORDER BY created_at DESC
    </select>

    <select id="countByFilters" resultType="int">
        SELECT COUNT(*) FROM tasks
        <include refid="genericFilterWhere"/>
    </select>

    <select id="findByFiltersPage" resultMap="TaskResultMap">
        SELECT * FROM tasks
        <include refid="genericFilterWhere"/>
        ORDER BY created_at DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="findFunctionalTasksFiltered" resultMap="TaskResultMap">
        SELECT * FROM tasks
        <where>
            AND task_type = #{taskType}
            <if test="status != null">
                AND status = #{status}
            </if>
            <if test="keyword != null and keyword != ''">
                AND (name LIKE CONCAT('%', #{keyword}, '%') OR description LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="days != null and days > 0">
                AND created_at &gt;= DATE_SUB(NOW(), INTERVAL #{days} DAY)
            </if>
        </where>
        ORDER BY created_at DESC
    </select>

    <sql id="functionalTestFilterWhere">
        <where>
            <if test="taskTypes != null and !taskTypes.isEmpty()">
                AND task_type IN
                <foreach collection="taskTypes" item="t" open="(" separator="," close=")">
                    #{t}
                </foreach>
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
            <if test="keyword != null and keyword != ''">
                AND (name LIKE CONCAT('%', #{keyword}, '%') OR description LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="days != null and days > 0">
                AND created_at &gt;= DATE_SUB(NOW(), INTERVAL #{days} DAY)
            </if>
        </where>
    </sql>

    <select id="countFunctionalTestTasksFiltered" resultType="int">
        SELECT COUNT(*) FROM tasks
        <include refid="functionalTestFilterWhere"/>
    </select>

    <select id="findFunctionalTasksFilteredPage" resultMap="TaskResultMap">
        SELECT * FROM tasks
        <include refid="functionalTestFilterWhere"/>
        ORDER BY created_at DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="existsById" resultType="boolean">
        SELECT COUNT(*) > 0 FROM tasks WHERE id = #{id}
    </select>
    
    <insert id="insert">
        INSERT INTO tasks (id, name, description, project_path, script_path, platform, device_id, app_id, task_type, scenario_key, status, created_at, updated_at, config, flow_id, run_track, worker_id)
        VALUES (#{id}, #{name}, #{description}, #{projectPath}, #{scriptPath}, #{platform}, #{deviceId}, #{appId}, #{taskType}, #{scenarioKey}, #{status}, #{createdAt}, #{updatedAt}, #{config}, #{flowId}, #{runTrack}, #{workerId})
    </insert>

    <update id="update">
        UPDATE tasks
        SET name = #{name},
            description = #{description},
            project_path = #{projectPath},
            script_path = #{scriptPath},
            platform = #{platform},
            device_id = #{deviceId},
            app_id = #{appId},
            task_type = #{taskType},
            scenario_key = #{scenarioKey},
            status = #{status},
            updated_at = #{updatedAt},
            config = #{config}
        WHERE id = #{id}
    </update>
    
    <delete id="deleteById">
        DELETE FROM tasks WHERE id = #{id}
    </delete>
    
</mapper>
