<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mobile.standalone.mapper.AppMapper">
    
    <resultMap id="AppResultMap" type="com.mobile.standalone.entity.App">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="packageName" column="package_name"/>
        <result property="version" column="version"/>
        <result property="deviceId" column="device_id"/>
        <result property="platform" column="platform"/>
        <result property="iconPath" column="icon_path"/>
        <result property="installTime" column="install_time"/>
        <result property="fileSize" column="file_size"/>
    </resultMap>
    
    <select id="findByDeviceId" resultMap="AppResultMap">
        SELECT * FROM apps
        WHERE device_id = #{deviceId}
        ORDER BY install_time DESC
    </select>
    
    <select id="findById" resultMap="AppResultMap">
        SELECT * FROM apps
        WHERE id = #{id}
    </select>
    
    <insert id="insert" parameterType="com.mobile.standalone.entity.App">
        INSERT INTO apps (
            id, name, package_name, version, device_id, platform,
            icon_path, install_time, file_size
        ) VALUES (
            #{id}, #{name}, #{packageName}, #{version}, #{deviceId}, #{platform},
            #{iconPath}, #{installTime}, #{fileSize}
        )
    </insert>
    
    <update id="update" parameterType="com.mobile.standalone.entity.App">
        UPDATE apps SET
            name = #{name},
            package_name = #{packageName},
            version = #{version},
            platform = #{platform},
            icon_path = #{iconPath},
            file_size = #{fileSize}
        WHERE id = #{id}
    </update>
    
    <delete id="deleteById">
        DELETE FROM apps WHERE id = #{id}
    </delete>
    
    <delete id="deleteByDeviceId">
        DELETE FROM apps WHERE device_id = #{deviceId}
    </delete>
    
</mapper>
