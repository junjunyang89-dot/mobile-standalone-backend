<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mobile.standalone.mapper.OnlineRegressionAccountMapper">

    <resultMap id="AccountMap" type="com.mobile.standalone.entity.OnlineRegressionAccount">
        <id property="id" column="id"/>
        <result property="appId" column="app_id"/>
        <result property="label" column="label"/>
        <result property="environment" column="environment"/>
        <result property="phoneNumber" column="phone_number"/>
        <result property="verificationCode" column="verification_code"/>
        <result property="enabled" column="enabled"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findEnabled" resultMap="AccountMap">
        SELECT * FROM online_regression_accounts
        WHERE enabled = 1
        <if test="appId != null and appId != ''">
            AND app_id = #{appId}
        </if>
        <!-- 空 environment 视为通用：存量账号没这个字段，不能因为加了列就一个都选不出来 -->
        <if test="environment != null and environment != ''">
            AND (environment = #{environment} OR environment IS NULL OR environment = '')
        </if>
        ORDER BY sort_order ASC, created_at ASC
    </select>

    <select id="findById" resultMap="AccountMap">
        SELECT * FROM online_regression_accounts WHERE id = #{id}
    </select>

    <insert id="insert">
        INSERT INTO online_regression_accounts
        (id, app_id, label, environment, phone_number, verification_code, enabled, sort_order, created_at, updated_at)
        VALUES
        (#{id}, #{appId}, #{label}, #{environment}, #{phoneNumber}, #{verificationCode}, #{enabled}, #{sortOrder}, #{createdAt}, #{updatedAt})
    </insert>
</mapper>
