server:
  port: 3080
  servlet:
    context-path: /api

spring:
  config:
    import: optional:file:.db-profile.properties
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    # 公司共享库公网直连
    url: jdbc:mysql://${DB_HOST:118.25.144.133}:${DB_PORT:13306}/${DB_NAME:mobile_standalone}?useUnicode=true&characterEncoding=UTF-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&rewriteBatchedStatements=true&connectionCollation=utf8mb4_unicode_ci&connectTimeout=60000&socketTimeout=120000&tcpKeepAlive=true
    username: ${DB_USERNAME:root}
    password: ${DB_PASSWORD:}
    hikari:
      maximum-pool-size: 10
      minimum-idle: 5
      connection-timeout: 30000
      idle-timeout: 600000
      max-lifetime: 1800000

mybatis:
  mapper-locations: classpath:mapper/*.xml
  type-aliases-package: com.mobile.standalone.entity
  configuration:
    map-underscore-to-camel-case: true

# 单机调试默认 ALL（控制面 + 执行都在本进程）。
# 只要控制面：mvn spring-boot:run -Dspring-boot.run.profiles=control
# 只要执行节点：mvn spring-boot:run -Dspring-boot.run.profiles=worker
app:
  node:
    role: ALL

# 主菜单 AI助手 + 页面编码/元素 key 翻译 → Cursor SDK（不再走千问）
# 密钥用环境变量，勿把生产 key 写进仓库
# export CURSOR_API_KEY=cursor_...
# 首次：cd scripts/cursor-ask && npm install
# cursor.ask.cwd 默认指向本机业务代码根目录
cursor:
  ask:
    enabled: true
    api-key: ${CURSOR_API_KEY:}
    cwd: ${user.home}/projects/qa_coding/app_coding
    # 环境搭建要同时看见服务源码、k8s-config、skills
    k8s-cwd: ${user.home}/projects/qa_coding
    model: default
    timeout-seconds: 300
    k8s-timeout-seconds: 600

# 抓包：H5/CDN/商城网关解密会搞挂页面，默认原样转发（不解密）
# app:
#   capture:
#     passthrough-hosts: pogpog.gg,unpkg.com,appengine.wmpvp.com

# 抓包收录猜归属用的网关路由（路径第一段=服务名），抄自 Apollo gateway 项目的
# spring.cloud.gateway.routes；不配就用代码里的默认值（2026-10 测试环境那份）
# app:
#   api-test:
#     gateway-routes: acty=app-community,avo=app-video,apppush=app-push,appuser=appuser

# 发版文档 / 上线看板（账号密码放本机 application.yml，勿提交）
# release-doc:
#   wiki-base-url: https://wiki.shdev.net
#   username: your.name
#   password: ***
#   branch-keywords:
#     - app-engine
#     - esports-api
#     - app-community
#     - data-center

# 发版看板 · Jenkins 大包状态（账号密码放本机 application.yml）
# release-jenkins:
#   enabled: true
#   base-url: http://jenkins.shdev.net
#   username: your.name
#   password: ***
#   jobs:
#     app-swift: appswift_package_prod
#     app-swift-v3: appswift_V3_package_prod
#     app-admin: appadmin_package_prod
#     data-center: datacenter_package_prod
#     comment-service: commentServer_package_ali_Prod

# 对外开放接口 /api/open/v1/**：其它管理平台查用例、下发 APP UI 自动化执行。
# 不配 clients 时整组接口返回 503（关闭），不会变成免鉴权。
# open-api:
#   clients:
#     - name: node-admin          # 调用方名，会出现在任务名里
#       key: 换成一串足够长的随机串   # 请求头 X-API-Key；也用来给回调签名
#       enabled: true
#   report-base-url: http://平台前端地址/   # 拼 reportUrl 用，不配就不返回
#   max-cases-per-run: 100
#   callback-max-attempts: 5

# 接入 ChatGPT（OpenAI 接口）。和千问是同一套 /chat/completions，换地址/密钥/模型即可。
# ai.chat.provider 管通用 AI：用例生成、逻辑改动翻译、AI 流程编排、元素识图、知识手册摘要等；
# 失败归因单独看 diagnosis.ai.provider（qwen | gemini | openai），两边可以各选各的。
# API 要在 platform.openai.com 单独开通计费，ChatGPT Plus 会员不含 API 额度。
# ai:
#   chat:
#     provider: qwen              # qwen | openai
#   openai:
#     api-key: ${OPENAI_API_KEY:}  # 密钥放环境变量或本机 application.yml，勿提交
#     api-base: https://api.openai.com/v1   # 走公司中转时改成中转地址
#     model: gpt-4.1              # 识图类功能要带视觉能力的模型
#     diagnosis-model:            # 失败归因用的模型，空则跟 model 走
#     proxy: http://127.0.0.1:7890   # 国内一般要配；只支持 HTTP 代理，不支持 SOCKS / 带账号密码

appium:
  enabled: true
  auto-start: true
  server-url: http://127.0.0.1:4723
  new-command-timeout: 300
  implicit-wait: 10
