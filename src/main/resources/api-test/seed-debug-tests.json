 {
  "id": "debug-test-09-nested-json",
  "project": "debug-tests",
  "name": "多层嵌套 JSON 样例",
  "description": "GET /debug-tests/nested-json，抽深层字段：userId / firstSku / txnId / displayName",
  "method": "GET",
  "path": "/debug-tests/nested-json",
  "query": "{\"scene\":\"demo\"}",
  "headers": "{\"Accept\":\"application/json\",\"Authorization\":\"Bearer {{token}}\"}",
  "body": null,
  "assertions": "[{\"type\":\"status\",\"equals\":200},{\"type\":\"jsonPath\",\"path\":\"$.code\",\"equals\":0},{\"type\":\"jsonPath\",\"path\":\"$.data.user.id\",\"equals\":\"u-1001\"},{\"type\":\"jsonPath\",\"path\":\"$.data.user.profile.address.detail.street\",\"equals\":\"世纪大道\"},{\"type\":\"jsonPath\",\"path\":\"$.data.order.items[0].sku\",\"equals\":\"SKU-A\"},{\"type\":\"jsonPath\",\"path\":\"$.data.order.pay.receipt.txnId\",\"equals\":\"TXN-7788\"},{\"type\":\"jsonPath\",\"path\":\"$.data.order.items[0].meta.tags[0]\",\"equals\":\"hot\"}]",
  "extractJson": "{\"nestedUserId\":\"$.data.user.id\",\"nestedDisplayName\":\"$.data.user.profile.displayName\",\"nestedFirstSku\":\"$.data.order.items[0].sku\",\"nestedTxnId\":\"$.data.order.pay.receipt.txnId\",\"nestedScene\":\"$.data.scene\",\"nestedTraceId\":\"$.meta.traceId\"}",
  "enabled": true,
  "sortOrder": 90,
  "createdBy": "seed-debug-tests",
  "environment": "ANY"
 },
 {
  "id": "debug-test-09b-nested-verify",
  "project": "debug-tests",
  "name": "嵌套 JSON 校验回显",
  "description": "POST /debug-tests/nested-json/verify，body 引用上一步深层 extract",
  "method": "POST",
  "path": "/debug-tests/nested-json/verify",
  "query": null,
  "headers": "{\"Accept\":\"application/json\",\"Content-Type\":\"application/json\",\"Authorization\":\"Bearer {{token}}\"}",
  "body": "{\"expect\":{\"userId\":\"{{nestedUserId}}\",\"firstSku\":\"{{nestedFirstSku}}\",\"txnId\":\"{{nestedTxnId}}\",\"scene\":\"{{nestedScene}}\"}}",
  "assertions": "[{\"type\":\"status\",\"equals\":200},{\"type\":\"jsonPath\",\"path\":\"$.verified\",\"equals\":true},{\"type\":\"jsonPath\",\"path\":\"$.checks.userIdMatched\",\"equals\":true},{\"type\":\"jsonPath\",\"path\":\"$.echo.layer.inner.txnId\",\"equals\":\"{{nestedTxnId}}\"},{\"type\":\"jsonPath\",\"path\":\"$.ticket\",\"exists\":true}]",
  "extractJson": "{\"nestedTicket\":\"$.ticket\"}",
  "enabled": true,
  "sortOrder": 91,
  "createdBy": "seed-debug-tests",
  "environment": "ANY"
 },
