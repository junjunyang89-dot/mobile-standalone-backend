 },
 {
  "id": "debug-test-02-list",
  "project": "debug-tests",
  "name": "列表查询 ACTIVE（嵌套前置）",
  "description": "GET /debug-tests?status=ACTIVE&limit=50，Bearer {{token}}，抽 debugId/debugName",
  "method": "GET",
  "path": "/debug-tests",
  "query": "{\"status\":\"ACTIVE\",\"limit\":\"50\"}",
  "headers": "{\"Accept\":\"application/json\",\"Authorization\":\"Bearer {{token}}\"}",
  "body": null,
  "assertions": "[{\"type\":\"status\",\"equals\":200},{\"type\":\"jsonPath\",\"path\":\"$[0].id\",\"exists\":true},{\"type\":\"jsonPath\",\"path\":\"$[0].name\",\"exists\":true}]",
  "extractJson": "{\"debugId\":\"$[0].id\",\"debugName\":\"$[0].name\"}",
  "enabled": true,
  "sortOrder": 20,
  "createdBy": "seed-debug-tests",
  "environment": "ANY"
 },
 {
  "id": "debug-test-02b-patch-enabled",
  "project": "debug-tests",
  "name": "切换 enabled（嵌套 debugId）",
  "description": "PATCH /debug-tests/{{debugId}}/enabled，验 name 与列表一致",
  "method": "PATCH",
  "path": "/debug-tests/{{debugId}}/enabled",
  "query": null,
  "headers": "{\"Accept\":\"application/json\",\"Content-Type\":\"application/json\",\"Authorization\":\"Bearer {{token}}\"}",
  "body": "{\"enabled\":false}",
  "assertions": "[{\"type\":\"status\",\"equals\":200},{\"type\":\"jsonPath\",\"path\":\"$.enabled\",\"equals\":false},{\"type\":\"jsonPath\",\"path\":\"$.name\",\"equals\":\"{{debugName}}\"}]",
  "extractJson": "{\"enabled\":\"$.enabled\"}",
  "enabled": true,
  "sortOrder": 25,
  "createdBy": "seed-debug-tests",
  "environment": "ANY"
 },
 {
  "id": "debug-test-02c-patch-enabled-restore",
  "project": "debug-tests",
  "name": "恢复 enabled（可重复跑）",
  "description": "PATCH /debug-tests/{{debugId}}/enabled 设回 true，避免下次列表为空",
  "method": "PATCH",
  "path": "/debug-tests/{{debugId}}/enabled",
  "query": null,
  "headers": "{\"Accept\":\"application/json\",\"Content-Type\":\"application/json\",\"Authorization\":\"Bearer {{token}}\"}",
  "body": "{\"enabled\":true}",
  "assertions": "[{\"type\":\"status\",\"equals\":200},{\"type\":\"jsonPath\",\"path\":\"$.enabled\",\"equals\":true},{\"type\":\"jsonPath\",\"path\":\"$.name\",\"equals\":\"{{debugName}}\"}]",
  "extractJson": null,
  "enabled": true,
  "sortOrder": 26,
  "createdBy": "seed-debug-tests",
  "environment": "ANY"
 },
 {
  "id": "debug-test-02d-snapshot",
  "project": "debug-tests",
  "name": "快照验 name（链路第5层）",
  "description": "GET /debug-tests/{{debugId}}/snapshot?expectName={{debugName}}",
  "method": "GET",
  "path": "/debug-tests/{{debugId}}/snapshot",
  "query": "{\"expectName\":\"{{debugName}}\"}",
  "headers": "{\"Accept\":\"application/json\",\"Authorization\":\"Bearer {{token}}\"}",
  "body": null,
  "assertions": "[{\"type\":\"status\",\"equals\":200},{\"type\":\"jsonPath\",\"path\":\"$.nameMatched\",\"equals\":true},{\"type\":\"jsonPath\",\"path\":\"$.snapshotId\",\"exists\":true},{\"type\":\"jsonPath\",\"path\":\"$.name\",\"equals\":\"{{debugName}}\"}]",
  "extractJson": "{\"snapshotId\":\"$.snapshotId\",\"detailScore\":\"$.score\"}",
  "enabled": true,
  "sortOrder": 27,
  "createdBy": "seed-debug-tests",
  "environment": "ANY"
 },
 {
  "id": "debug-test-02e-set-score",
  "project": "debug-tests",
  "name": "设 score（链路第6层）",
  "description": "POST /debug-tests/{{debugId}}/score，抽 newScore",
  "method": "POST",
  "path": "/debug-tests/{{debugId}}/score",
  "query": null,
  "headers": "{\"Accept\":\"application/json\",\"Content-Type\":\"application/json\",\"Authorization\":\"Bearer {{token}}\"}",
  "body": "{\"score\":85}",
  "assertions": "[{\"type\":\"status\",\"equals\":200},{\"type\":\"jsonPath\",\"path\":\"$.newScore\",\"equals\":85},{\"type\":\"jsonPath\",\"path\":\"$.id\",\"exists\":true}]",
  "extractJson": "{\"newScore\":\"$.newScore\",\"previousScore\":\"$.previousScore\"}",
  "enabled": true,
  "sortOrder": 28,
  "createdBy": "seed-debug-tests",
  "environment": "ANY"
 },
 {
  "id": "debug-test-02f-chain-echo",
  "project": "debug-tests",
  "name": "链路回显（链路第7层）",
  "description": "POST /debug-tests/{{debugId}}/chain-echo，body 引用前几层变量",
  "method": "POST",
  "path": "/debug-tests/{{debugId}}/chain-echo",
  "query": "{\"tag\":\"{{snapshotId}}\"}",
  "headers": "{\"Accept\":\"application/json\",\"Content-Type\":\"application/json\",\"Authorization\":\"Bearer {{token}}\"}",
  "body": "{\"refId\":\"{{debugId}}\",\"refName\":\"{{debugName}}\",\"refSnapshotId\":\"{{snapshotId}}\",\"refScore\":{{newScore}},\"refEnabled\":true}",
  "assertions": "[{\"type\":\"status\",\"equals\":200},{\"type\":\"jsonPath\",\"path\":\"$.chainVerified\",\"equals\":true},{\"type\":\"jsonPath\",\"path\":\"$.chainDepth\",\"equals\":4},{\"type\":\"jsonPath\",\"path\":\"$.chainToken\",\"exists\":true}]",
  "extractJson": "{\"chainToken\":\"$.chainToken\"}",
  "enabled": true,
  "sortOrder": 29,
  "createdBy": "seed-debug-tests",
  "environment": "ANY"
 },
 {
  "id": "debug-test-02g-chain-receipt",
  "project": "debug-tests",
  "name": "链路收据（链路第8层）",
  "description": "GET /debug-tests/{{debugId}}/chain-receipt，query 汇总 snapshotId/newScore/debugName",
  "method": "GET",
  "path": "/debug-tests/{{debugId}}/chain-receipt",
  "query": "{\"snapshotId\":\"{{snapshotId}}\",\"score\":\"{{newScore}}\",\"name\":\"{{debugName}}\"}",
  "headers": "{\"Accept\":\"application/json\",\"Authorization\":\"Bearer {{token}}\"}",
  "body": null,
  "assertions": "[{\"type\":\"status\",\"equals\":200},{\"type\":\"jsonPath\",\"path\":\"$.allPassed\",\"equals\":true},{\"type\":\"jsonPath\",\"path\":\"$.layersChecked\",\"equals\":5},{\"type\":\"jsonPath\",\"path\":\"$.finalScore\",\"equals\":85}]",
  "extractJson": "{\"receiptId\":\"$.receiptId\"}",
  "enabled": true,
  "sortOrder": 30,
  "createdBy": "seed-debug-tests",
  "environment": "ANY"
 },
 {
