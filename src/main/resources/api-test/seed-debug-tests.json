[
 {
  "id": "debug-test-00-login",
  "project": "debug-tests",
  "name": "登录拿 token",
  "description": "POST /auth/login，抽 token 供后续 Bearer。环境变量配 loginUsername/loginPassword，或直接改 body",
  "method": "POST",
  "path": "/auth/login",
  "query": null,
  "headers": "{\"Accept\":\"application/json\",\"Content-Type\":\"application/json\"}",
  "body": "{\"username\":\"{{loginUsername}}\",\"password\":\"{{loginPassword}}\"}",
  "assertions": "[{\"type\":\"status\",\"equals\":200},{\"type\":\"jsonPath\",\"path\":\"$.token\",\"exists\":true}]",
  "extractJson": "{\"token\":\"$.token\"}",
  "enabled": true,
  "sortOrder": 5,
  "createdBy": "seed-debug-tests",
  "environment": "ANY"
 },
 {
  "id": "debug-test-01-ping",
  "project": "debug-tests",
  "name": "ping 探活",
  "description": "GET /debug-tests/ping",
  "method": "GET",
  "path": "/debug-tests/ping",
  "query": null,
  "headers": "{\"Accept\":\"application/json\"}",
  "body": null,
  "assertions": "[{\"type\":\"status\",\"equals\":200},{\"type\":\"jsonPath\",\"path\":\"$.ok\",\"equals\":true},{\"type\":\"jsonPath\",\"path\":\"$.module\",\"equals\":\"debug-tests\"}]",
  "extractJson": null,
  "enabled": true,
  "sortOrder": 10,
  "createdBy": "seed-debug-tests",
  "environment": "ANY"
 },
 {
  "id": "debug-test-02-list",
  "project": "debug-tests",
  "name": "列表查询 ACTIVE（嵌套前置）",
  "description": "GET /debug-tests?status=ACTIVE&limit=50，Bearer {{token}}，抽 debugId/debugName",
  "method": "GET",
  "path": "/debug-tests",
  "query": "{\"status\":\"ACTIVE\",\"limit\":\"50\"}",
  "headers": "{\"Accept\":\"application/json\",\"Authorization\":\"Bearer {{token}}\"}",
  "body": null,
  "assertions": "[{\"type\":\"status\",\"equals\":200},{\"type\":\"jsonPath\",\"path\":\"$[0].id\",\"exists\":true},{\"type\":\"jsonPath\",\"path\":\"$[0].name\",\"exists\":true}]",
  "extractJson": "{\"debugId\":\"$[0].id\",\"debugName\":\"$[0].name\"}",
  "enabled": true,
  "sortOrder": 20,
  "createdBy": "seed-debug-tests",
  "environment": "ANY"
 },
 {
  "id": "debug-test-02b-patch-enabled",
  "project": "debug-tests",
  "name": "切换 enabled（嵌套 debugId）",
  "description": "PATCH /debug-tests/{{debugId}}/enabled，验 name 与列表一致",
  "method": "PATCH",
  "path": "/debug-tests/{{debugId}}/enabled",
  "query": null,
  "headers": "{\"Accept\":\"application/json\",\"Content-Type\":\"application/json\",\"Authorization\":\"Bearer {{token}}\"}",
  "body": "{\"enabled\":false}",
  "assertions": "[{\"type\":\"status\",\"equals\":200},{\"type\":\"jsonPath\",\"path\":\"$.enabled\",\"equals\":false},{\"type\":\"jsonPath\",\"path\":\"$.name\",\"equals\":\"{{debugName}}\"}]",
  "extractJson": "{\"enabled\":\"$.enabled\"}",
  "enabled": true,
  "sortOrder": 25,
  "createdBy": "seed-debug-tests",
  "environment": "ANY"
 },
 {
  "id": "debug-test-02c-patch-enabled-restore",
  "project": "debug-tests",
  "name": "恢复 enabled（可重复跑）",
  "description": "PATCH /debug-tests/{{debugId}}/enabled 设回 true，避免下次列表为空",
  "method": "PATCH",
  "path": "/debug-tests/{{debugId}}/enabled",
  "query": null,
  "headers": "{\"Accept\":\"application/json\",\"Content-Type\":\"application/json\",\"Authorization\":\"Bearer {{token}}\"}",
  "body": "{\"enabled\":true}",
  "assertions": "[{\"type\":\"status\",\"equals\":200},{\"type\":\"jsonPath\",\"path\":\"$.enabled\",\"equals\":true},{\"type\":\"jsonPath\",\"path\":\"$.name\",\"equals\":\"{{debugName}}\"}]",
  "extractJson": null,
  "enabled": true,
  "sortOrder": 26,
  "createdBy": "seed-debug-tests",
  "environment": "ANY"
 },
 {
  "id": "debug-test-03-create",
  "project": "debug-tests",
  "name": "新增调试行",
  "description": "POST /debug-tests",
  "method": "POST",
  "path": "/debug-tests",
  "query": null,
  "headers": "{\"Accept\":\"application/json\",\"Content-Type\":\"application/json\"}",
  "body": "{\"name\":\"对比样例-{{$timestamp}}\",\"status\":\"ACTIVE\",\"score\":90,\"remark\":\"自动化\",\"extra\":\"{}\"}",
  "assertions": "[{\"type\":\"status\",\"equals\":200},{\"type\":\"jsonPath\",\"path\":\"$.name\",\"contains\":\"对比样例-\"},{\"type\":\"jsonPath\",\"path\":\"$.id\",\"exists\":true},{\"type\":\"jsonPath\",\"path\":\"$.status\",\"equals\":\"ACTIVE\"}]",
  "extractJson": "{\"createdId\":\"$.id\"}",
  "enabled": true,
  "sortOrder": 30,
  "createdBy": "seed-debug-tests",
  "environment": "ANY"
 },
 {
  "id": "debug-test-04-get",
  "project": "debug-tests",
  "name": "按 id 查详情",
  "description": "GET /debug-tests/{{createdId}}，依赖上一条 extract",
  "method": "GET",
  "path": "/debug-tests/{{createdId}}",
  "query": null,
  "headers": "{\"Accept\":\"application/json\"}",
  "body": null,
  "assertions": "[{\"type\":\"status\",\"equals\":200},{\"type\":\"jsonPath\",\"path\":\"$.id\",\"exists\":true},{\"type\":\"jsonPath\",\"path\":\"$.status\",\"equals\":\"ACTIVE\"}]",
  "extractJson": null,
  "enabled": true,
  "sortOrder": 40,
  "createdBy": "seed-debug-tests",
  "environment": "ANY"
 },
 {
  "id": "debug-test-05-update",
  "project": "debug-tests",
  "name": "更新调试行",
  "description": "PUT /debug-tests/{{createdId}}",
  "method": "PUT",
  "path": "/debug-tests/{{createdId}}",
  "query": null,
  "headers": "{\"Accept\":\"application/json\",\"Content-Type\":\"application/json\"}",
  "body": "{\"name\":\"对比样例-已改\",\"status\":\"ACTIVE\",\"score\":91}",
  "assertions": "[{\"type\":\"status\",\"equals\":200},{\"type\":\"jsonPath\",\"path\":\"$.name\",\"equals\":\"对比样例-已改\"},{\"type\":\"jsonPath\",\"path\":\"$.score\",\"equals\":91}]",
  "extractJson": null,
  "enabled": true,
  "sortOrder": 50,
  "createdBy": "seed-debug-tests",
  "environment": "ANY"
 },
 {
  "id": "debug-test-06-echo",
  "project": "debug-tests",
  "name": "回显 body",
  "description": "POST /debug-tests/{{createdId}}/echo?tag=foo",
  "method": "POST",
  "path": "/debug-tests/{{createdId}}/echo",
  "query": "{\"tag\":\"foo\"}",
  "headers": "{\"Accept\":\"application/json\",\"Content-Type\":\"application/json\"}",
  "body": "{\"name\":\"echo-test\",\"status\":\"ACTIVE\",\"score\":1}",
  "assertions": "[{\"type\":\"status\",\"equals\":200},{\"type\":\"jsonPath\",\"path\":\"$.tag\",\"equals\":\"foo\"},{\"type\":\"jsonPath\",\"path\":\"$.body.name\",\"equals\":\"echo-test\"}]",
  "extractJson": null,
  "enabled": true,
  "sortOrder": 60,
  "createdBy": "seed-debug-tests",
  "environment": "ANY"
 },
 {
  "id": "debug-test-07-delete",
  "project": "debug-tests",
  "name": "删除调试行",
  "description": "DELETE /debug-tests/{{createdId}}",
  "method": "DELETE",
  "path": "/debug-tests/{{createdId}}",
  "query": null,
  "headers": "{\"Accept\":\"application/json\"}",
  "body": null,
  "assertions": "[{\"type\":\"status\",\"equals\":200},{\"type\":\"jsonPath\",\"path\":\"$.ok\",\"equals\":true}]",
  "extractJson": null,
  "enabled": true,
  "sortOrder": 70,
  "createdBy": "seed-debug-tests",
  "environment": "ANY"
 },
 {
  "id": "debug-test-08-create-bad",
