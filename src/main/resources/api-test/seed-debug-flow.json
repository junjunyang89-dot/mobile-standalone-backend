[
  {
    "id": "debug-flow-00-login",
    "project": "debug-flow",
    "name": "平台登录拿 Bearer",
    "description": "POST /auth/login，环境变量 loginUsername/loginPassword",
    "method": "POST",
    "path": "/auth/login",
    "query": null,
    "headers": "{\"Accept\":\"application/json\",\"Content-Type\":\"application/json\"}",
    "body": "{\"username\":\"{{loginUsername}}\",\"password\":\"{{loginPassword}}\"}",
    "assertions": "[{\"type\":\"status\",\"equals\":200},{\"type\":\"jsonPath\",\"path\":\"$.token\",\"exists\":true}]",
    "extractJson": "{\"token\":\"$.token\"}",
    "enabled": true,
    "sortOrder": 5,
    "createdBy": "seed-debug-flow",
    "environment": "ANY"
  },
  {
    "id": "debug-flow-01-reset",
    "project": "debug-flow",
    "name": "清空 debug-flow 内存态",
    "description": "POST /debug-flow/reset，保证可重复跑",
    "method": "POST",
    "path": "/debug-flow/reset",
    "query": null,
    "headers": "{\"Accept\":\"application/json\",\"Authorization\":\"Bearer {{token}}\"}",
    "body": null,
    "assertions": "[{\"type\":\"status\",\"equals\":200},{\"type\":\"jsonPath\",\"path\":\"$.ok\",\"equals\":true}]",
    "extractJson": null,
    "enabled": true,
    "sortOrder": 10,
    "createdBy": "seed-debug-flow",
    "environment": "ANY"
  },
  {
    "id": "debug-flow-02-session",
    "project": "debug-flow",
    "name": "开会话（抽 sessionToken/accountId）",
    "description": "POST /debug-flow/session → $.result.auth.session.token / $.result.auth.account.id",
    "method": "POST",
    "path": "/debug-flow/session",
    "query": null,
    "headers": "{\"Accept\":\"application/json\",\"Content-Type\":\"application/json\",\"Authorization\":\"Bearer {{token}}\"}",
    "body": "{\"actor\":\"flow-tester\"}",
    "assertions": "[{\"type\":\"status\",\"equals\":200},{\"type\":\"jsonPath\",\"path\":\"$.code\",\"equals\":0},{\"type\":\"jsonPath\",\"path\":\"$.result.auth.session.token\",\"exists\":true},{\"type\":\"jsonPath\",\"path\":\"$.result.auth.account.profile.tier\",\"equals\":\"GOLD\"}]",
    "extractJson": "{\"flowSessionToken\":\"$.result.auth.session.token\",\"flowSessionId\":\"$.result.auth.session.id\",\"flowAccountId\":\"$.result.auth.account.id\",\"flowTraceId\":\"$.meta.traceId\"}",
    "enabled": true,
    "sortOrder": 20,
    "createdBy": "seed-debug-flow",
    "environment": "ANY"
  },
  {
    "id": "debug-flow-03-catalog",
    "project": "debug-flow",
    "name": "查目录（抽 productId/sku/unitPrice）",
    "description": "GET /debug-flow/catalog?accountId=&sessionToken= → 嵌套 groups[0].products[0]",
    "method": "GET",
    "path": "/debug-flow/catalog",
    "query": "{\"accountId\":\"{{flowAccountId}}\",\"sessionToken\":\"{{flowSessionToken}}\"}",
    "headers": "{\"Accept\":\"application/json\",\"Authorization\":\"Bearer {{token}}\"}",
    "body": null,
    "assertions": "[{\"type\":\"status\",\"equals\":200},{\"type\":\"jsonPath\",\"path\":\"$.code\",\"equals\":0},{\"type\":\"jsonPath\",\"path\":\"$.data.catalog.groups[0].products[0].id\",\"equals\":\"P-2001\"},{\"type\":\"jsonPath\",\"path\":\"$.data.catalog.groups[0].products[0].offer.price.unit\",\"equals\":39.9}]",
    "extractJson": "{\"flowProductId\":\"$.data.catalog.groups[0].products[0].id\",\"flowSku\":\"$.data.catalog.groups[0].products[0].sku\",\"flowUnitPrice\":\"$.data.catalog.groups[0].products[0].offer.price.unit\",\"flowProductTitle\":\"$.data.catalog.groups[0].products[0].title\"}",
    "enabled": true,
    "sortOrder": 30,
    "createdBy": "seed-debug-flow",
    "environment": "ANY"
  },
  {
    "id": "debug-flow-04-cart",
    "project": "debug-flow",
    "name": "加购（抽 cartId/lineId）",
    "description": "POST /debug-flow/cart，body 引用上一步商品字段",
    "method": "POST",
    "path": "/debug-flow/cart",
    "query": null,
    "headers": "{\"Accept\":\"application/json\",\"Content-Type\":\"application/json\",\"Authorization\":\"Bearer {{token}}\"}",
    "body": "{\"sessionToken\":\"{{flowSessionToken}}\",\"productId\":\"{{flowProductId}}\",\"sku\":\"{{flowSku}}\",\"qty\":2,\"unitPrice\":{{flowUnitPrice}}}",
    "assertions": "[{\"type\":\"status\",\"equals\":200},{\"type\":\"jsonPath\",\"path\":\"$.code\",\"equals\":0},{\"type\":\"jsonPath\",\"path\":\"$.result.cart.lines[0].product.sku\",\"equals\":\"{{flowSku}}\"},{\"type\":\"jsonPath\",\"path\":\"$.result.cart.summary.lineCount\",\"equals\":1}]",
    "extractJson": "{\"flowCartId\":\"$.result.cart.id\",\"flowLineId\":\"$.result.cart.lines[0].lineId\",\"flowSubtotal\":\"$.result.cart.lines[0].subtotal\"}",
    "enabled": true,
    "sortOrder": 40,
    "createdBy": "seed-debug-flow",
    "environment": "ANY"
  },
  {
    "id": "debug-flow-05-checkout",
    "project": "debug-flow",
    "name": "下单（抽 orderId/payToken）",
    "description": "POST /debug-flow/checkout → $.data.checkout.order.id / payment.token",
    "method": "POST",
    "path": "/debug-flow/checkout",
    "query": null,
    "headers": "{\"Accept\":\"application/json\",\"Content-Type\":\"application/json\",\"Authorization\":\"Bearer {{token}}\"}",
    "body": "{\"sessionToken\":\"{{flowSessionToken}}\",\"cartId\":\"{{flowCartId}}\"}",
    "assertions": "[{\"type\":\"status\",\"equals\":200},{\"type\":\"jsonPath\",\"path\":\"$.code\",\"equals\":0},{\"type\":\"jsonPath\",\"path\":\"$.data.checkout.order.status\",\"equals\":\"PENDING_PAY\"},{\"type\":\"jsonPath\",\"path\":\"$.data.checkout.order.items[0].sku\",\"equals\":\"{{flowSku}}\"}]",
    "extractJson": "{\"flowOrderId\":\"$.data.checkout.order.id\",\"flowPayToken\":\"$.data.checkout.order.payment.token\",\"flowOrderAmount\":\"$.data.checkout.order.amount.value\"}",
    "enabled": true,
    "sortOrder": 50,
    "createdBy": "seed-debug-flow",
    "environment": "ANY"
  },
  {
    "id": "debug-flow-06-pay",
    "project": "debug-flow",
    "name": "支付（抽 txnId/receiptNo）",
    "description": "POST /debug-flow/pay → $.result.payment.receipt.txn.id",
    "method": "POST",
    "path": "/debug-flow/pay",
    "query": null,
    "headers": "{\"Accept\":\"application/json\",\"Content-Type\":\"application/json\",\"Authorization\":\"Bearer {{token}}\"}",
    "body": "{\"sessionToken\":\"{{flowSessionToken}}\",\"orderId\":\"{{flowOrderId}}\",\"payToken\":\"{{flowPayToken}}\"}",
    "assertions": "[{\"type\":\"status\",\"equals\":200},{\"type\":\"jsonPath\",\"path\":\"$.code\",\"equals\":0},{\"type\":\"jsonPath\",\"path\":\"$.result.payment.status\",\"equals\":\"PAID\"},{\"type\":\"jsonPath\",\"path\":\"$.result.payment.receipt.txn.status\",\"equals\":\"SUCCESS\"},{\"type\":\"jsonPath\",\"path\":\"$.result.payment.receipt.orderRef.sku\",\"equals\":\"{{flowSku}}\"}]",
    "extractJson": "{\"flowTxnId\":\"$.result.payment.receipt.txn.id\",\"flowReceiptNo\":\"$.result.payment.receipt.no\"}",
    "enabled": true,
    "sortOrder": 60,
    "createdBy": "seed-debug-flow",
    "environment": "ANY"
  },
  {
    "id": "debug-flow-07-ticket",
    "project": "debug-flow",
    "name": "终态票据（嵌套校验整链）",
    "description": "GET /debug-flow/orders/{{flowOrderId}}/ticket?txnId={{flowTxnId}}",
    "method": "GET",
    "path": "/debug-flow/orders/{{flowOrderId}}/ticket",
    "query": "{\"txnId\":\"{{flowTxnId}}\",\"sessionToken\":\"{{flowSessionToken}}\"}",
    "headers": "{\"Accept\":\"application/json\",\"Authorization\":\"Bearer {{token}}\"}",
    "body": null,
    "assertions": "[{\"type\":\"status\",\"equals\":200},{\"type\":\"jsonPath\",\"path\":\"$.code\",\"equals\":0},{\"type\":\"jsonPath\",\"path\":\"$.ticket.body.verify.allPassed\",\"equals\":true},{\"type\":\"jsonPath\",\"path\":\"$.ticket.body.verify.layers\",\"equals\":6},{\"type\":\"jsonPath\",\"path\":\"$.ticket.body.chain.sku\",\"equals\":\"{{flowSku}}\"},{\"type\":\"jsonPath\",\"path\":\"$.ticket.body.chain.txnId\",\"equals\":\"{{flowTxnId}}\"},{\"type\":\"jsonPath\",\"path\":\"$.ticket.body.print.lines[2].v\",\"equals\":\"{{flowTxnId}}\"}]",
    "extractJson": "{\"flowTicketOrderId\":\"$.ticket.header.orderId\"}",
    "enabled": true,
    "sortOrder": 70,
    "createdBy": "seed-debug-flow",
    "environment": "ANY"
  }
]
